# OpsPilot Environment Configuration Example

# Application
PROJECT_NAME="OpsPilot"
ENVIRONMENT="development"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_secret
POSTGRES_DB=opspilot_db
DATABASE_URL=postgresql://opspilot:opspilot_secret@localhost:5432/opspilot_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Docker Runtime
DOCKER_HOST_URL="unix:///var/run/docker.sock"

# GitHub Integration (Phase 2)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

